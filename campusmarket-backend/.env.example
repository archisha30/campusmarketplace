# Copy this to .env and fill in the real values.

APP_NAME=CampusMarket API
ENVIRONMENT=development

# Supabase dashboard -> your project -> Project Settings -> Database ->
# Connection string -> URI tab -> "Transaction" pooler mode (port 6543) is fine
# for a small student project and works better with serverless-style connects
# than the direct connection (port 5432).
# It looks like: postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Replace [YOUR-PASSWORD] with your actual database password (set when you created the project,
# or reset it from Project Settings -> Database -> Reset database password).
DATABASE_URL=

# Your Vite dev server origin, add your deployed frontend URL later too
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth ---
# Generate these two yourself, run in your terminal:
#   openssl rand -hex 32   -> JWT_SECRET_KEY
#   openssl rand -hex 16   -> OTP_PEPPER
# Never commit real values, .env is already in .gitignore.
JWT_SECRET_KEY=
OTP_PEPPER=

# Which college email domains are allowed to sign up
ALLOWED_EMAIL_DOMAINS=["polaris.edu"]

# --- Email (Gmail SMTP, free) ---
# 1. Turn on 2-Step Verification on a Gmail account: myaccount.google.com/security
# 2. Create an app password: myaccount.google.com/apppasswords
# 3. Google gives you a 16-character code, that's SMTP_PASSWORD below (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=
SMTP_FROM=youraddress@gmail.com
