# HTTPS in front of the CampusMarket API. setup.sh copies this to /etc/caddy/Caddyfile with the
# real domain in place of api.example.com; Caddy gets and renews the certificate by itself.
{
	servers {
		# Requests come from Vercel's servers (vercel.json rewrites /api/* here), which put the
		# student's address in X-Forwarded-For. Trusting every sender makes Caddy keep that header
		# and append the connecting address, instead of replacing it with just Vercel's address,
		# which would put every student under one shared login/code limit. The API trusts only
		# the entry Caddy appends (PROXY_HOPS=1); see client_ips in app/core/ratelimit.py.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

api.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/campusmarket.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
