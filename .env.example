# Point the frontend at your FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api

# Supabase (auth + storage). Leave blank to keep the mock auth adapter running.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "mock" to run entirely on sample data, "live" to hit the API.
VITE_DATA_SOURCE=mock
